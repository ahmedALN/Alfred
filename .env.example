GEMINI_API_KEY=
# Voice (speech-to-speech). Must support bidiGenerateContent.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Reasoning / memory. "-latest" tracks the current flash model.
GEMINI_TEXT_MODEL=gemini-flash-latest

ALFRED_NAME=Alfred

# ------------------------------------------------------------------
# Swappable AI backends for reasoning / embeddings / vision.
# Voice ALWAYS uses Gemini Live (needs GEMINI_API_KEY) and is not
# affected by these.
#
#   ALFRED_AI_PROVIDER = gemini | ollama | openai
#     gemini  - Google API, needs GEMINI_API_KEY (default)
#     ollama  - local, no key, needs Ollama running
#     openai  - any OpenAI-compatible endpoint (NVIDIA NIM, vLLM,
#               LM Studio, llama.cpp server, Groq, OpenAI, ...)
# ------------------------------------------------------------------
ALFRED_AI_PROVIDER=gemini

# Optional: override the backend for one capability only.
#ALFRED_AI_CHAT_PROVIDER=ollama
#ALFRED_AI_EMBED_PROVIDER=ollama
#ALFRED_AI_VISION_PROVIDER=gemini

# Optional: override the model per capability. Sensible defaults are
# used per provider (gemini: GEMINI_TEXT_MODEL / gemini-embedding-001 /
# gemini-flash-latest;  ollama: qwen3.5 / nomic-embed-text / moondream).
# On an 8 GB GPU: qwen3.5:4b (fits fully, ~2-3s/decision). qwen3.5 is
# multimodal so it covers vision too - no separate model needed.
# Alfred disables Ollama "thinking" mode automatically (it adds 60s+).
#ALFRED_AI_CHAT_MODEL=qwen3.5:4b
#ALFRED_AI_EMBED_MODEL=nomic-embed-text
#ALFRED_AI_VISION_MODEL=qwen3.5:4b

# ollama
ALFRED_OLLAMA_BASE_URL=http://localhost:11434

# openai-compatible endpoint. NVIDIA NIM by default - a free key from
# build.nvidia.com (starts "nvapi-") unlocks the planning model below.
ALFRED_OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
ALFRED_OPENAI_API_KEY=

# --- Task planning ------------------------------------------------
# Multi-step tasks are PLANNED by a stronger model, then executed
# step-by-step by the fast local one. The planner is a fallback chain:
# on an error / rate limit / quota it drops to the next rung, and a
# failed rung is skipped until its cooldown expires.
ALFRED_AI_PLAN_PROVIDER=openai
ALFRED_AI_PLAN_MODEL=nvidia/nemotron-3-super-120b-a12b
ALFRED_AI_PLAN_FALLBACKS=gemini,ollama

# Probe each planner at startup and put the reachable ones first (costs
# ~5-10s at boot; off by default - the chain self-heals after one call).
ALFRED_PLAN_PROBE=false

ALFRED_DEFAULT_DESKTOP=2
ALFRED_USER_DESKTOP=1

# Where Alfred's long-term memory (facts learned over time) is stored.
ALFRED_MEMORY_DB=alfred_memory.sqlite3

# Skill library: after Alfred finishes AND verifies a task you asked for,
# it distils the tool sequence into a replayable skill, so the same
# request next time skips planning. Manage with: python -m src.skills
ALFRED_SKILLS_ENABLED=true
ALFRED_SKILL_DB=alfred_skills.sqlite3

# Episodic memory: a timestamped log of what Alfred actually did, so it
# can answer "what have you done today?". Browse: python -m src.episodes
ALFRED_EPISODE_DB=alfred_episodes.sqlite3

# App memory: what Alfred learned about working INSIDE each app - the
# real window title, the control names that worked, quirks. Makes the
# second task in an app much faster. Browse: python -m src.apps
ALFRED_APP_DB=alfred_apps.sqlite3

# ------------------------------------------------------------------
# Proactive brain: the background loop that watches the machine and
# proactively speaks or acts without being asked.
# ------------------------------------------------------------------

# Master on/off switch for the whole background loop.
ALFRED_BRAIN_ENABLED=true

# How much the brain may do on its own:
#   ask             - every state change is confirmed out loud first
#   auto_reversible - auto-run reversible actions, confirm the rest
#   full            - act freely and report; destructive PowerShell and
#                     the hard guardrail list are still always refused
ALFRED_BRAIN_AUTONOMY=full

# Seconds between awareness ticks.
ALFRED_BRAIN_TICK_SECONDS=90

# Minimum seconds between unprompted spoken interruptions
# (bypassed only for high-urgency items).
ALFRED_BRAIN_MIN_SPEAK_GAP=600

# Optional quiet window, "HH:MM-HH:MM" (may wrap midnight). The brain
# still senses and logs during quiet hours, it just stays silent.
ALFRED_BRAIN_QUIET_HOURS=hello world from Alfred

# Deliberate even when nothing changed, every N ticks (0 = never).
ALFRED_BRAIN_HEARTBEAT_TICKS=0

# Append-only audit log of everything the brain perceives and does.
# A ".jsonl" mirror is written next to it.
ALFRED_BRAIN_AUDIT_DB=alfred_brain_audit.sqlite3

# System-tray icon (pause/resume awareness, open logs, quit).helloworldfromAlfred
ALFRED_TRAY_ENABLED=true

# --- Activation ---------------------------------------------------
# Instead of streaming the mic to Gemini 24/7, Alfred stays asleep
# until woken by the wake word or the hotkey, listens for a
# conversation, then sleeps again after a silence.
ALFRED_WAKE_ENABLED=true
# Custom wake phrase (Vosk keyword spotting, no training). Run
# `ui_controlworks.` once, then set e.g.:
#ALFRED_WAKE_PHRASE=hey alfred
ALFRED_WAKE_PHRASE=
# Or a trained openWakeWord model. Empty + no phrase = bundled "hey jarvis".
ALFRED_WAKE_MODEL=
ALFRED_WAKE_THRESHOLD=0.5
# Global push-to-talk hotkey (always available alongside the wake word).
ALFRED_HOTKEY=ctrl+alt+k
# Seconds of silence before Alfred stops listening and re-arms the wake word.
ALFRED_LISTEN_IDLE_SECONDS=30
# Mute the mic while Alfred is speaking (stops it hearing itself on a
# speaker setup). Disables barge-in; turn off if you use headphones.
ALFRED_HALF_DUPLEX=true

# --- Game / low-resource mode -----------------------------------
# Auto-engage low-resource mode when a fullscreen game is foreground.
ALFRED_GAME_AUTODETECT=true
ALFRED_GAME_DETECT_SECONDS=30

# Start Alfred automatically at logon:
#   python -m src.autostart install     (or: uninstall / status)

LOG_LEVEL=INFO

# Overlay a coordinate grid on screenshots so the vision model reads
# pixel positions accurately (helps small local VLMs a lot).
ALFRED_DESKTOP_GRID=true

# Hold proactive messages for the first N seconds after startup, then
# deliver them together as one sentence (avoids a burst at boot).
ALFRED_BRAIN_STARTUP_GRACE=60

# Optional: a spoken passphrase gate on dangerous actions (stop-services,
# firewall changes, rm -rf, etc.). Say it once, valid for the window below.
# Catastrophic actions stay refused regardless. Leave blank to disable.
ALFRED_VOICE_PASSPHRASE=
ALFRED_VOICE_PASSPHRASE_WINDOW=300

# --- Local voice fallback -------------------------------------
# When the Gemini quota is hit, talk to Alfred locally for a while
# (faster-whisper + your local chat model + Piper TTS), then retry
# the cloud. Say "switch back" to end it early.
ALFRED_LOCAL_VOICE_FALLBACK=true
ALFRED_LOCAL_VOICE_COOLDOWN=300
ALFRED_LOCAL_VOICE_STT_MODEL=base.en
