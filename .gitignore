# ===================================================================
#  Alfred - what never leaves this machine
#
#  Two kinds of thing are excluded here, and the first kind matters
#  much more than the second.
#
#  Secrets and your life: the API keys, the Google tokens, and every
#  store Alfred writes. Those stores are not caches - they hold what
#  Alfred has learned about you, your WhatsApp contacts and message
#  keys, who has emailed you, and what you have had on screen. They
#  are the most private files on the machine.
#
#  Then the ordinary noise: virtualenvs, build output, caches.
# ===================================================================

# --- secrets -------------------------------------------------------
.env
.env.*
!.env.example

gmail_client.json
gmail_token.json
*credentials*.json
*client_secret*.json
token.json

# The interface's address carries this run's access key.
.alfred_interface_url

# --- your life: everything Alfred remembers ------------------------
# Memories, skills, tasks, schedule, world model, activity, undo,
# audit - and the WhatsApp session, which holds contacts, message
# keys and the pairing for your account.
alfred_*.sqlite3
alfred_*.json
alfred_*.jsonl
*.sqlite
*.sqlite3
*.db
*.jsonl

# Anything Alfred has seen or heard
screenshots/
recordings/
*.wav
*.mp3
*.pcm
*.mp4
debug-child-desktop.png
src/windows/native/ChildScreenCapture/child-*.png

# Its own diaries and measurements
logs/
bench-*.json
bench-*.log
teach-*.log
teach-*.json

# --- downloaded, not authored --------------------------------------
# Vosk / Piper / wake-word models. setup fetches these; they are
# hundreds of megabytes and belong to their own projects.
models/

# --- environments and caches ---------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- .NET build output ---------------------------------------------
[Bb]in/
[Oo]bj/
*.user

# --- editors and tools ---------------------------------------------
.idea/
.vscode/
.claude/
*.swp
.DS_Store
Thumbs.db

# --- scratch -------------------------------------------------------
tmp/
cache/
scratch_*
